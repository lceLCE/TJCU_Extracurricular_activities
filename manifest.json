{
  "manifest_version": 3,
  "name": "Fuck TJCU 体育打卡",
  "version": "1.0.1",
  "description": "一款让你足不出户就能成功完成天津商业大学体育打卡的妙妙Chrome浏览器插件",
  "minimum_chrome_version": "116",
  "permissions": ["geolocation", "offscreen"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://peawx.sec.tjcu.edu.cn/*",
        "https://peawx.sec.tjcu.edu.cn/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://peawx.sec.tjcu.edu.cn/*",
        "https://peawx.sec.tjcu.edu.cn/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}

